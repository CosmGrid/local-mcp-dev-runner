;; Stage 0D Host Helper Seatbelt Profile Template (Exact Stage 0C Baseline)
(version 1)
(deny default)

(import "system.sb")

;; Process execution policy: allow fork and only the specific helper binary
(allow process-fork)
(allow process-exec (literal "%%HELPER_BIN%%"))

;; Filesystem containment: allow read/write strictly inside the per-run allowed directory
(allow file-read* file-write* (subpath "%%ALLOWED_DIR%%"))
