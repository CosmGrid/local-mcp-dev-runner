#!/bin/sh
# Stage 0B VirtioFS isolation guest probe.
#
# Runs as PID 1 inside the Alpine initramfs (kernel cmdline rdinit=/stage0b-init).
# It does NOT replace Alpine's /init; it is an ADDITIONAL early-userspace init
# selected by the kernel's rdinit= parameter. Original /init stays intact.
#
# EVIDENCE CHANNEL (Stage 0B Evidence-Pipeline Repair):
#   Every marker is emitted to the guest CONSOLE (stdout) FIRST, unconditionally.
#   The host attaches that console with VZFileHandleSerialPortAttachment and
#   captures it into a bounded buffer. Writing to the VirtioFS share is
#   SECONDARY and only happens when the mount actually succeeded.
#
#   Why: the previous run produced empty guest evidence. With results written
#   only through the share, a failed mount is indistinguishable from "the guest
#   never reached stage0b-init" or "the console was never attached". Console-first
#   emission makes those three cases separable, which is required before any
#   "virtiofs unsupported" verdict may be issued.
#
# Marker order (lowest layer first):
#   STAGE0B_GUEST_INIT_STARTED   emitted before anything can fail
#   STAGE0B_GUEST_PID1           $$ == 1 ?
#   STAGE0B_GUEST_BEFORE_VIRTIOFS
#   VIRTIOFS_MODPROBE_RC / VIRTIOFS_FSTYPE_LISTED   capability probes
#   VIRTIOFS_MOUNT_RC / VIRTIOFS_MOUNT / VIRTIOFS_MOUNT_ERROR
#   ... IO + escape gates ...
#   STAGE0B_GUEST_DONE=YES       host may stop the VM early on this
#
# VIRTIOFS_MOUNT_ERROR is a SAFE classification only (UNKNOWN_FILESYSTEM /
# NO_SUCH_DEVICE / PERMISSION_DENIED / MOUNTPOINT_MISSING / ALREADY_MOUNTED /
# NONE / OTHER). Raw mount stderr is NEVER emitted — it can carry host paths.
#
# All markers are FAKE random strings (no real secrets).
set +e

# ================= lowest layer: prove we were executed at all =================
echo "STAGE0B_GUEST_INIT_STARTED=YES"

if [ "$$" = "1" ]; then
  echo "STAGE0B_GUEST_PID1=YES"
else
  echo "STAGE0B_GUEST_PID1=NO"
fi

# --- minimal early-userspace environment (busybox) ---
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

if [ -x /bin/busybox ]; then
  /bin/busybox --install -s 2>/dev/null || true
  /bin/busybox mkdir -p /proc /sys /dev /worktree /tmp 2>/dev/null || true
  /bin/busybox mount -t proc proc /proc 2>/dev/null || true
  /bin/busybox mount -t sysfs sysfs /sys 2>/dev/null || true
  /bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
else
  mkdir -p /proc /sys /dev /worktree /tmp 2>/dev/null || true
  mount -t proc proc /proc 2>/dev/null || true
  mount -t sysfs sysfs /sys 2>/dev/null || true
  mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
fi

echo "STAGE0B_GUEST_BEFORE_VIRTIOFS=YES"

# ================= virtiofs capability + mount =================
# Is the fstype known to this kernel at all? (CONFIG_VIRTIO_FS / module loaded)
if grep -q "virtiofs" /proc/filesystems 2>/dev/null; then
  VIRTIOFS_FSTYPE_LISTED=YES
else
  VIRTIOFS_FSTYPE_LISTED=NO
fi

modprobe virtiofs >/dev/null 2>&1
VIRTIOFS_MODPROBE_RC=$?

MOUNT_BIN=""
if [ -x /bin/busybox ]; then
  MOUNT_BIN="/bin/busybox mount"
elif command -v mount >/dev/null 2>&1; then
  MOUNT_BIN="mount"
fi

if [ -z "$MOUNT_BIN" ]; then
  VIRTIOFS_MOUNT_RC=127
  VIRTIOFS_MOUNT=FAIL
  VIRTIOFS_MOUNT_ERROR=MOUNT_COMMAND_MISSING
else
  MOUNT_ERR_FILE=/tmp/lmdr-stage0b-mount-err
  : > "$MOUNT_ERR_FILE" 2>/dev/null
  $MOUNT_BIN -t virtiofs lmdr-stage0b /worktree 2> "$MOUNT_ERR_FILE"
  VIRTIOFS_MOUNT_RC=$?

  if [ "$VIRTIOFS_MOUNT_RC" = "0" ]; then
    VIRTIOFS_MOUNT=PASS
    VIRTIOFS_MOUNT_ERROR=NONE
  else
    VIRTIOFS_MOUNT=FAIL
    classify_mount_error() {
      e="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
      case "$e" in
        *"unknown filesystem"*|*"bad file type"*)          echo "UNKNOWN_FILESYSTEM" ;;
        *"no such device"*|*"cannot find"*)                 echo "NO_SUCH_DEVICE" ;;
        *"invalid argument"*)                               echo "INVALID_ARGUMENT" ;;
        *"permission denied"*|*"operation not permitted"*)  echo "PERMISSION_DENIED" ;;
        *)                                                  echo "OTHER" ;;
      esac
    }
    VIRTIOFS_MOUNT_ERROR="$(classify_mount_error "$(cat "$MOUNT_ERR_FILE" 2>/dev/null)")"
  fi
  rm -f "$MOUNT_ERR_FILE" 2>/dev/null
fi

# Guest-side support verdict. Only a filesystem-level "I do not know this fstype
# / there is no such device" answer proves the guest cannot do VirtioFS. Any
# other failure mode is UNPROVEN, not a support verdict.
if [ "$VIRTIOFS_MOUNT" = "PASS" ]; then
  VIRTIOFS_GUEST_SUPPORT=PASS
else
  case "$VIRTIOFS_MOUNT_ERROR" in
    UNKNOWN_FILESYSTEM|NO_SUCH_DEVICE) VIRTIOFS_GUEST_SUPPORT=FAIL ;;
    *)                                 VIRTIOFS_GUEST_SUPPORT=UNPROVEN ;;
  esac
fi

echo "VIRTIOFS_FSTYPE_LISTED=$VIRTIOFS_FSTYPE_LISTED"
echo "VIRTIOFS_MODPROBE_RC=$VIRTIOFS_MODPROBE_RC"
echo "VIRTIOFS_MOUNT_RC=$VIRTIOFS_MOUNT_RC"
echo "VIRTIOFS_MOUNT=$VIRTIOFS_MOUNT"
echo "VIRTIOFS_MOUNT_ERROR=$VIRTIOFS_MOUNT_ERROR"
echo "VIRTIOFS_GUEST_SUPPORT=$VIRTIOFS_GUEST_SUPPORT"

# ================= secondary channel: share-backed results file ===============
R=/worktree/guest-results.txt
R_WRITABLE=NO
if [ "$VIRTIOFS_MOUNT" = "PASS" ]; then
  : > "$R" 2>/dev/null && R_WRITABLE=YES
fi
echo "GUEST_RESULTS_WRITABLE=$R_WRITABLE"

emit() {
  echo "$*"
  if [ "$R_WRITABLE" = "YES" ]; then echo "$*" >> "$R"; fi
}

# ---- host HOME exposure: does not depend on the share ----
if [ -e /Users ]; then
  HOST_HOME_EXPOSED_TO_GUEST=YES
else
  HOST_HOME_EXPOSED_TO_GUEST=NO
fi
emit "HOST_HOME_EXPOSED_TO_GUEST=$HOST_HOME_EXPOSED_TO_GUEST"

# ---- network device check: does not depend on the share ----
GUEST_INTERFACES=""
GUEST_HAS_VIRTIO_NET=NO
if [ -f /proc/net/dev ]; then
  iface_list=$(grep -v 'lo:' /proc/net/dev 2>/dev/null | awk -F: 'NR>1 {print $1}' | tr -d ' ' | grep -v '^$' | tr '\n' ',')
  GUEST_INTERFACES="${iface_list%,}"
fi
if [ -n "$GUEST_INTERFACES" ]; then
  GUEST_HAS_VIRTIO_NET=YES
else
  GUEST_INTERFACES="NONE"
fi
emit "GUEST_HAS_VIRTIO_NET=$GUEST_HAS_VIRTIO_NET"
emit "GUEST_INTERFACES=$GUEST_INTERFACES"

# ================= share-dependent gates =================
if [ "$VIRTIOFS_MOUNT" != "PASS" ]; then
  # No share -> the IO and path-escape gates have no data. INCONCLUSIVE / NOT_RUN, never empty.
  emit "GUEST_READ_HOST_MARKER=NOT_RUN"
  emit "GUEST_WRITE_MARKER=NOT_RUN"
  emit "DOTDOT_ESCAPE=INCONCLUSIVE"
  emit "SYMLINK_ESCAPE_REL=INCONCLUSIVE"
  emit "SYMLINK_ESCAPE_ABS=INCONCLUSIVE"
  emit "ABSOLUTE_PATH_ESCAPE=INCONCLUSIVE"
  emit "PROBE_SPEC_LOADED=NO"
  emit "STAGE0B_GUEST_DONE=YES"
  sync 2>/dev/null
  while true; do sleep 3600; done
fi

# --- load the probe spec the host placed in the allowed share ---
SECRET=""
DOTDOT=""
SYMLINK_REL=""
SYMLINK_ABS=""
ABS_PATH=""
PROBE_SPEC_LOADED=NO
if [ -f /worktree/probe-spec.sh ]; then
  . /worktree/probe-spec.sh
  PROBE_SPEC_LOADED=YES
fi
# fail-closed: without a real secret value the escape gates cannot be evaluated
if [ -z "$SECRET" ] || [ "$SECRET" = "LMDR_STAGE0B_DENIED_UNSET" ]; then
  PROBE_SPEC_LOADED=NO
fi
emit "PROBE_SPEC_LOADED=$PROBE_SPEC_LOADED"

if [ "$PROBE_SPEC_LOADED" != "YES" ]; then
  emit "GUEST_READ_HOST_MARKER=NOT_RUN"
  emit "GUEST_WRITE_MARKER=NOT_RUN"
  emit "DOTDOT_ESCAPE=INCONCLUSIVE"
  emit "SYMLINK_ESCAPE_REL=INCONCLUSIVE"
  emit "SYMLINK_ESCAPE_ABS=INCONCLUSIVE"
  emit "ABSOLUTE_PATH_ESCAPE=INCONCLUSIVE"
  emit "STAGE0B_GUEST_DONE=YES"
  sync 2>/dev/null
  while true; do sleep 3600; done
fi

# --- IO gate ---
GUEST_READ_VAL=$(cat /worktree/host-read.txt 2>/dev/null)
[ -z "$GUEST_READ_VAL" ] && GUEST_READ_VAL="NOT_FOUND"
emit "GUEST_READ_HOST_MARKER=$GUEST_READ_VAL"

GUEST_WRITE_MARKER="LMDR_STAGE0B_GUESTWRITE_$(head -c 8 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
echo "$GUEST_WRITE_MARKER" > /worktree/guest-write.txt 2>/dev/null
emit "GUEST_WRITE_MARKER=$GUEST_WRITE_MARKER"

# --- path-escape helper ---
# FAIL  = the denied secret was actually read (share escape)
# PASS  = contained
read_secret() {
  got=$(cat "/worktree/$1" 2>/dev/null)
  if [ -n "$got" ] && [ "$got" = "$SECRET" ]; then
    echo "FAIL"
  else
    echo "PASS"
  fi
}

# DOTDOT: worktree/../denied-sentinel/<secretfile>
DOTDOT_ESCAPE=$(read_secret "$DOTDOT")
emit "DOTDOT_ESCAPE=$DOTDOT_ESCAPE"

# SYMLINK (relative): worktree/escape-link/<secretfile>  (escape-link -> ../denied-sentinel)
SYMLINK_ESCAPE_REL=$(read_secret "$SYMLINK_REL")
emit "SYMLINK_ESCAPE_REL=$SYMLINK_ESCAPE_REL"

# SYMLINK (absolute): worktree/escape-link-abs/<secretfile>
SYMLINK_ESCAPE_ABS=$(read_secret "$SYMLINK_ABS")
emit "SYMLINK_ESCAPE_ABS=$SYMLINK_ESCAPE_ABS"

# ABSOLUTE PATH: the guest uses the host's absolute denied-sentinel path
# VERBATIM (NOT prefixed with /worktree — that would make the check vacuous).
got_abs=$(cat "$ABS_PATH" 2>/dev/null)
if [ -n "$got_abs" ] && [ "$got_abs" = "$SECRET" ]; then
  ABSOLUTE_PATH_ESCAPE=FAIL
else
  ABSOLUTE_PATH_ESCAPE=PASS
fi
emit "ABSOLUTE_PATH_ESCAPE=$ABSOLUTE_PATH_ESCAPE"

emit "STAGE0B_GUEST_DONE=YES"
sync 2>/dev/null

# idle so the host controls VM stop (host stops early on STAGE0B_GUEST_DONE)
while true; do
  if [ -x /bin/busybox ]; then
    /bin/busybox sleep 3600 2>/dev/null || sleep 3600 2>/dev/null || read _ 2>/dev/null || true
  else
    sleep 3600 2>/dev/null || read _ 2>/dev/null || true
  fi
done
